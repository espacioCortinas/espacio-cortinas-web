// Configuración del Worker de Cloudflare que sirve el sitio.
//
// El build no lo genera Next directamente: `opennextjs-cloudflare build` toma
// la salida de `next build` y arma `.open-next/`, con el servidor en
// `worker.js` y los archivos estáticos en `assets/`.
//
// Ver docs/arquitectura.md y la decisión 24 de docs/decisiones.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Tiene que coincidir con el nombre del Worker en el panel de Cloudflare.
  "name": "espacio-cortinas-web",
  "main": ".open-next/worker.js",

  // Fija el comportamiento del runtime a esta fecha: subir la versión de
  // `workerd` no cambia la semántica de lo ya desplegado. Se actualiza a
  // propósito, igual que la versión de Next.
  "compatibility_date": "2026-07-29",

  // `nodejs_compat` es obligatorio: el adaptador corre el servidor de Next
  // sobre las APIs de Node que provee Workers. Sin esto no arranca.
  //
  // `global_fetch_strictly_public` hace que un `fetch()` a nuestro propio
  // dominio salga a internet en vez de volver al mismo Worker. Sin esto, una
  // petición del servidor a una URL del sitio se resuelve en bucle.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // ── Variables de entorno del runtime ──────────────────────────────────────
  //
  // ACÁ ES DONDE MIRA WRANGLER. `wrangler deploy` trata a este bloque como la
  // fuente de verdad: en cada despliegue deja el Worker exactamente con estas
  // variables de texto y borra cualquier otra que se haya cargado a mano en el
  // panel. Eso tumbó el sitio el 14/08/2026, y declararlas acá ataca la causa
  // en vez del síntoma — decisión 30.
  //
  // Quedó una sola al sacar el panel (decisión 36): las tres de Supabase se
  // fueron con la base. Esta lleva prefijo `NEXT_PUBLIC_`, así que Next la
  // incrusta en el paquete que descarga el navegador — no hay nada que
  // proteger, y sí algo que ganar: el valor de producción se lee en un diff,
  // con historial, en vez de ser un Secret que nadie puede volver a leer.
  //
  // Sin `www` y sin barra final — decisión 22. Es el único valor que difiere a
  // propósito de `.env.local`, donde en local es http://localhost:3000.
  //
  // Ojo: esto es la lista de RUNTIME. La de build («Build variables and
  // secrets», en el panel) es otra y este archivo no la toca.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://espaciocortinas.com.ar",
  },

  // Los estáticos los sirve Cloudflare directamente, sin ejecutar el Worker.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },

  // Registros del Worker. Incluido en el plan gratuito y es la única forma de
  // ver por qué falló una petición en producción.
  "observability": {
    "enabled": true,
  },
}
