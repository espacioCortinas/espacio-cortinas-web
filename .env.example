# Plantilla de variables de entorno.
#
# Copiar a .env.local y completar. Este archivo SÍ se versiona; .env.local NO.
# Nunca escribir un valor real acá.
#
# Las mismas variables se cargan en Cloudflare, en el Worker, y van DOS VECES:
#   - Settings → Build → «Build variables and secrets»  → las necesita el build
#   - Settings → «Variables and Secrets»                → las necesita el Worker
# Las secretas (SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY) se cargan siempre
# como Secret, nunca como Text. Referencia: docs/arquitectura.md y
# docs/infraestructura.md.

# ─── Obligatorias desde la Fase 1 ────────────────────────────────────────────

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO SERVIDOR. Saltea RLS por diseño: nunca con prefijo NEXT_PUBLIC_,
# nunca en un componente cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Base para canonical, sitemap y Open Graph. Sin barra final.
# Local: http://localhost:3000 — Producción: https://espaciocortinas.com.ar
NEXT_PUBLIC_SITE_URL=

# ─── Se cargan en la Fase 2 ──────────────────────────────────────────────────

# user.id del único administrador, creado a mano en Supabase Auth.
ADMIN_USER_ID=

# ─── Se cargan en la Fase 4.6 ────────────────────────────────────────────────

# Número en formato internacional, sin espacios ni signos. Ej: 5491122334455
NEXT_PUBLIC_WHATSAPP=

RESEND_API_KEY=
EMAIL_CONTACTO=
